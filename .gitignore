# ==========================================
# 1. SENSITIVE CREDENTIALS (CRITICAL)
# ==========================================
# Never commit your OpenAI, Serper, or Groq API keys!
.env
*.env
.env.*

# ==========================================
# 2. PYTHON & VIRTUAL ENVIRONMENTS (uv)
# ==========================================
# Blocks your 1GB+ local virtual environment folder
.venv/
venv/
ENV/
env/

# Python compiled bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# 3. CREWAI & OUTPUTS
# ==========================================
# Ignores local markdown reports or text outputs generated by agents
# (Allows your main README and AGENTS files to be pushed)
report.md
report

# ==========================================
# 4. OPERATING SYSTEM FILES
# ==========================================
.DS_Store
Thumbs.db